<footer class="site-footer">
  <div class="wrap site-footer__inner">
    <div class="site-footer__brand">
      <img src="/assets/img/poster/logo-ink.png" width="464" height="532" alt="Save Fort Hill!" loading="lazy">
    </div>
    <div class="site-footer__body">
      <p class="site-footer__tagline">{{ site.tagline }}</p>
      <ul class="site-footer__links">
        <li><a href="{{ site.letter_url }}">{{ site.letter_label }}</a></li>
        <li><a href="{{ site.signup_url }}">{{ site.signup_label }}</a></li>
        {%- for item in nav | rejectattr("hidden") %}
        <li><a href="{{ item.url }}">{{ item.label }}</a></li>
        {%- endfor %}
        {%- if site.email %}
        <li><a href="mailto:{{ site.email }}">{{ site.email }}</a></li>
        {%- endif %}
      </ul>
      {%- if site.footer_note %}
      <p class="site-footer__note">{{ site.footer_note }}</p>
      {%- endif %}
    </div>
  </div>
</footer>
