{%- set nav = [
  { url: "/faq/", label: "FAQ" },
  { url: "/press/", label: "Press" },
  { url: "/contact/", label: "Contact" }
] -%}
<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="site-header__logo" href="/" {% if page.url == "/" %}aria-current="page"{% endif %}>
      <img src="/assets/img/poster/logo-wide-ink.png" width="1419" height="181" alt="Save Fort Hill! — home">
    </a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {%- for item in nav %}
        <li><a href="{{ item.url }}" {% if page.url == item.url %}aria-current="page"{% endif %}>{{ item.label }}</a></li>
        {%- endfor %}
        <li><a class="button button--small" href="{{ site.signup_url }}">Sign up</a></li>
      </ul>
    </nav>
  </div>
</header>
