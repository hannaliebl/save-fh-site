---
layout: layouts/base.njk
---
<section class="hero">
  {#- Composition follows the march poster. Decorations are cut from it; purely visual. #}
  <img class="hero__decor hero__decor--bolt-right" src="/assets/img/poster/bolt-right.png" alt="" width="196" height="523">
  <img class="hero__decor hero__decor--bolt-left" src="/assets/img/poster/bolt-left.png" alt="" width="137" height="452">
  <div class="hero__inner">
    <div class="hero__mark">
      <img class="hero__decor hero__decor--mega-left" src="/assets/img/poster/megaphone-left.png" alt="" width="238" height="206">
      <h1 class="hero__logo">
        <img src="/assets/img/poster/logo-white.png" alt="{{ site.title }}!" width="464" height="532">
      </h1>
      <img class="hero__decor hero__decor--tulip" src="/assets/img/poster/tulip.png" alt="" width="126" height="240">
    </div>
    {%- if hero.headline %}<p class="hero__headline">{{ hero.headline | trim | escape | replace("\n", "<br>") | safe }}</p>{% endif %}
    {%- if hero.subhead %}<p class="hero__subhead">{{ hero.subhead }}</p>{% endif %}
    <div class="hero__actions">
      <a class="button button--large button--primary" href="{{ site.letter_url }}">{{ site.letter_label }}</a>
      <a class="button button--large button--ghost" href="{{ site.signup_url }}">{{ site.signup_label }}</a>
    </div>
    {%- if hero.kicker %}<p class="hero__kicker">{{ hero.kicker }}</p>{% endif %}
  </div>
</section>

{%- if events and events.length %}
{#- Events with a poster/photo are featured; the rest go in a compact "Key dates" list. #}
{%- set featured = events | selectattr("image") %}
{%- set dates = events | rejectattr("image") %}
<section class="wrap section events" aria-labelledby="events-heading">
  <div class="section__head">
    <h2 id="events-heading">Upcoming events</h2>
  </div>
  <div class="events__grid{% if not featured.length or not dates.length %} events__grid--single{% endif %}">
    {%- if featured.length %}
    <ul class="events__featured">
      {%- for event in featured %}
      <li class="event">
        <img class="event__image" src="{{ event.image }}" alt="{{ event.image_alt }}" width="900" height="900" loading="lazy">
        <div class="event__body">
          <h3 class="event__title">{{ event.title }}</h3>
          {%- if event.when or event.where %}
          <p class="event__when">
            {%- if event.when %}<strong>{{ event.when }}</strong>{% endif %}
            {%- if event.when and event.where %}<br>{% endif %}
            {%- if event.where %}{{ event.where }}{% endif %}
          </p>
          {%- endif %}
          {%- if event.details %}<p class="event__details">{{ event.details }}</p>{% endif %}
          {%- if event.link %}<p><a class="button" href="{{ event.link }}">Details</a></p>{% endif %}
        </div>
      </li>
      {%- endfor %}
    </ul>
    {%- endif %}
    {%- if dates.length %}
    <div class="events__dates">
      <h3 class="events__dates-title">Key dates</h3>
      <ul class="date-list">
        {%- for event in dates %}
        <li class="date-list__item">
          {%- if event.when %}<p class="date-list__when">{{ event.when }}</p>{% endif %}
          <p class="date-list__title">
            {%- if event.link %}<a href="{{ event.link }}">{{ event.title }}</a>{% else %}{{ event.title }}{% endif %}
          </p>
          {%- if event.where %}<p class="date-list__meta">{{ event.where }}</p>{% endif %}
          {%- if event.details %}<p class="date-list__meta">{{ event.details }}</p>{% endif %}
        </li>
        {%- endfor %}
      </ul>
    </div>
    {%- endif %}
  </div>
</section>
{%- endif %}

{%- if press.length %}
<section class="wrap section" aria-labelledby="press-heading">
  <div class="section__head">
    <h2 id="press-heading">In the media</h2>
    <a class="section__more" href="/press/">All coverage →</a>
  </div>
  {%- set items = press.slice(0, 4) %}
  {% include "partials/press-cards.njk" %}
</section>
{%- endif %}

{%- if facts and facts.length %}
<section class="facts" aria-label="Key facts">
  <ul class="wrap facts__list">
    {%- for fact in facts %}
    <li class="fact">
      <span class="fact__number">{{ fact.number }}</span>
      <span class="fact__label">{{ fact.label }}</span>
    </li>
    {%- endfor %}
  </ul>
</section>
{%- endif %}

<div class="wrap section">
  <div class="prose">
    {{ content | safe }}
  </div>
</div>

{% include "partials/signup-band.njk" %}
