---
layout: layouts/base.njk
---
{% include "partials/page-header.njk" %}

<div class="wrap section page-grid">
  <div class="page-grid__main">
    <div class="prose prose--lead">
      {{ content | safe }}
    </div>

    <h2 class="visually-hidden">Coverage</h2>
    {%- set items = press | byDateDesc %}
    {%- if items.length %}
    {% include "partials/press-list.njk" %}
    {%- else %}
    <p>Coverage will be listed here.</p>
    {%- endif %}
  </div>

  {%- if media_contact and (media_contact.email or media_contact.phone) %}
  <aside class="page-grid__side card" aria-labelledby="media-contact">
    <h2 id="media-contact" class="card__title">Media inquiries</h2>
    {%- if media_contact.name %}<p class="card__name">{{ media_contact.name }}</p>{% endif %}
    {%- if media_contact.role %}<p class="card__role">{{ media_contact.role }}</p>{% endif %}
    <ul class="card__links">
      {%- if media_contact.email %}<li><a href="mailto:{{ media_contact.email }}">{{ media_contact.email }}</a></li>{% endif %}
      {%- if media_contact.phone %}<li><a href="tel:{{ media_contact.phone | replace(r/[^0-9+]/g, '') }}">{{ media_contact.phone }}</a></li>{% endif %}
    </ul>
  </aside>
  {%- endif %}
</div>

{% include "partials/signup-band.njk" %}
